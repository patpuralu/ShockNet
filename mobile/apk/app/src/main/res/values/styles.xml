<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principal de la app -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#E8192C</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorAccent">#E8192C</item>
        <item name="android:windowBackground">#080808</item>
        <item name="android:textColorPrimary">#EEEEEE</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Tema del splash — negro puro, sin barra de estado -->
    <style name="SplashTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!--
        Tema de la alerta — pantalla completa.
        NOTA: windowShowWhenLocked, windowTurnScreenOn y windowDismissKeyguard
        se aplican en código (AlertActivity.onCreate) porque en XML
        solo funcionan con compileSdk >= 27 con AppCompat.
        Aquí solo ponemos lo que sí funciona en Theme.Material.
    -->
    <style name="AlertTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
